# Local development only. This project reads no credentials from the
# environment in production -- the Cloudflare API token is supplied per
# request via the X-Cloudflare-Api-Token HTTP header (see README). The
# variables below are non-credential runtime configuration only.

MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# Override only for testing against something other than the real
# Cloudflare API.
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
